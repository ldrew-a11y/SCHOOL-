import pygame

pygame.init()
#set the dimensions of the window
WINDOW_WIDTH = 1000
WINDOW_HEIGHT = 900
# Set the title of the window
display_surface = pygame.display.set_mode((WINDOW_HEIGHT, WINDOW_WIDTH))
pygame.display.set_caption("CANMAN")

#COlORS
RED = (255,0,0)
GREEN = (0,255,0)
BLUE = (0,0,255)
BLACK = (0,0,0)

#IMAGE
Canman = pygame.image.load("CAN MAN.png")
Can_Left_rect = Canman.get_rect(center=(100,100))
Can_Left_rect.center = (450, 220)

#Fonts list to choose from 
fonts = pygame.font.get_fonts()
for font in fonts:
    print(font)

# my font cooperblack
system_font = pygame.font.SysFont("cooperblack", 60)
custom_font = pygame.font.Font("Attackgraffiti.ttf", 50)



#What i want the text to say
system_text = system_font.render("HELLO ALL", True, BLUE )
system_text_rect = system_text.get_rect()
system_text_rect.center = (WINDOW_HEIGHT//2, WINDOW_WIDTH//2)


#SOUND EFFECTS GOAL!, MISS, LOSS, WIN
Sound_Background = pygame.mixer.Sound("Jungle_Music.wav")
Sound_Goal = pygame.mixer.Sound("applause.wav")

Sound_Background.play()
pygame.time.delay(10000)
Sound_Goal.play()




#game LOOP
running = True
while running:
    #LIST of obj that occured
    for event in pygame.event.get():
        print(event)
        if event.type == pygame.QUIT:
            running = False
    
   
   #BLit IMAGE
    display_surface.blit(Canman,Can_Left_rect)
    #BLIT TEXT
    display_surface.blit(system_text, system_text_rect)





    pygame.display.update()

pygame.quit







